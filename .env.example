# Pod environment contract
# This file reflects actual runtime usage in the current codebase.

# Required
# Generate with: bun -e "import { randomBytes } from 'node:crypto'; console.log(randomBytes(32).toString('hex'))"
JWT_SECRET=
# Set to a non-default dashboard password before first production start
INITIAL_PASSWORD=

# Optional override. Leave unset locally to use ~/.pod.
# The Docker image sets DATA_DIR=/app/data by default.
DATA_DIR=/app/data

# Recommended runtime variables
PORT=20128
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Recommended security and ops variables
# Generate with: bun -e "import { randomBytes } from 'node:crypto'; console.log(randomBytes(32).toString('hex'))"
API_KEY_SECRET=
SHUTDOWN_SECRET=
MACHINE_ID_SALT=endpoint-proxy-salt
ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true
OBSERVABILITY_MAX_RECORDS=200
OBSERVABILITY_BATCH_SIZE=20
OBSERVABILITY_FLUSH_INTERVAL_MS=5000
OBSERVABILITY_MAX_JSON_SIZE=5
AUTH_COOKIE_SECURE=false
REQUIRE_API_KEY=false

# Provider-specific OAuth secrets (only needed if you use these providers)
IFLOW_OAUTH_CLIENT_SECRET=
QODER_OAUTH_CLIENT_ID=
QODER_OAUTH_CLIENT_SECRET=

# Cloud sync variables
# Must point to this running instance so internal sync jobs can call /api/sync/cloud.
# Server-side preferred variables:
BASE_URL=http://localhost:20128
CLOUD_URL=https://pod.lazuardy.tech
# Backward-compatible/public variables:
NEXT_PUBLIC_BASE_URL=http://localhost:20128
NEXT_PUBLIC_CLOUD_URL=https://pod.lazuardy.tech

# Optional outbound proxy variables for upstream provider calls
# Lowercase variants are also supported: http_proxy, https_proxy, all_proxy, no_proxy
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# Optional web-search provider override (useful in docker-compose with sidecar SearXNG)
# SEARXNG_BASE_URL=http://searxng:8080/search

# Currently unused by application runtime (kept as reference)
# INSTANCE_NAME=pod
