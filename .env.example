# Pod environment contract — copy to `.env` (gitignored).
# Generate secrets: bun -e "import { randomBytes } from 'node:crypto'; console.log(randomBytes(32).toString('hex'))"
# JWT_SECRET and API_KEY_SECRET are required at process start (all NODE_ENV except test/build).

# ── Required ────────────────────────────────────────────────────────────────
JWT_SECRET=
API_KEY_SECRET=
# Dashboard first-login password. Default in code is 123456 if unset.
INITIAL_PASSWORD=

# ── Local defaults ──────────────────────────────────────────────────────────
PORT=20128
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1
AUTH_COOKIE_SECURE=false
REQUIRE_API_KEY=false
BASE_URL=http://localhost:20128
NEXT_PUBLIC_BASE_URL=http://localhost:20128
# Leave DATA_DIR unset locally → ~/.pod. Docker sets DATA_DIR=/app/data.

# ── Optional ops ────────────────────────────────────────────────────────────
# SHUTDOWN_SECRET=
# MACHINE_ID_SALT=endpoint-proxy-salt
# ENABLE_REQUEST_LOGS=false
# ENABLE_TRANSLATOR=false
# LOG_LEVEL=
# OBSERVABILITY_ENABLED=true
# OBSERVABILITY_MAX_RECORDS=200
# OBSERVABILITY_BATCH_SIZE=20
# OBSERVABILITY_FLUSH_INTERVAL_MS=5000
# OBSERVABILITY_MAX_JSON_SIZE=5
# POD_MAX_REQUEST_BODY_BYTES=52428800
# POD_MAX_CHAT_BODY_BYTES=

# ── Cache (in-memory) ───────────────────────────────────────────────────────
# SEMANTIC_CACHE_MAX_BYTES=4194304
# SEMANTIC_CACHE_MAX_SIZE=100
# SEMANTIC_CACHE_TTL_MS=1800000
# PROMPT_CACHE_MAX_BYTES=2097152
# PROMPT_CACHE_MAX_SIZE=50
# PROMPT_CACHE_TTL_MS=300000

# ── Redis rate limit (optional; in-memory fallback if unset) ────────────────
# REDIS_URL=
# RATELIMIT_KEY_PREFIX=
# RATELIMIT_REDIS_TIMEOUT_MS=1000

# ── Cloudflare Worker (optional) ────────────────────────────────────────────
# CLOUD_URL=
# NEXT_PUBLIC_CLOUD_URL=

# ── Provider OAuth (only if you use these providers) ────────────────────────
# IFLOW_OAUTH_CLIENT_SECRET=
# QODER_OAUTH_CLIENT_ID=
# QODER_OAUTH_CLIENT_SECRET=

# ── Docker / Zeabur only (do not copy to local) ─────────────────────────────
# HOSTNAME=0.0.0.0
# PORT=20140
# DATA_DIR=/app/data
# POD_CANARY_HOST=          # prod service → canary service id
# POD_HOST=                 # canary service → prod service id

# Optional outbound proxy for upstream provider calls
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY= http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# SEARXNG_BASE_URL=http://searxng:8080/search

# Optional Headroom token compressor (HTTP client only; Pod does not spawn it)
# HEADROOM_URL=http://localhost:8787
