{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "allowJs": false,
    "types": ["@cloudflare/workers-types"],
    "baseUrl": ".",
    "paths": {
      "open-sse": ["../open-sse"],
      "open-sse/*": ["../open-sse/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "../src"]
}
