{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["nextjs", "typescript", "react"],
  "categories": {
    "correctness": "warn"
  },
  "rules": {
    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "no-constant-condition": "error",
    "eqeqeq": "warn"
  },
  "overrides": [
    {
      "files": ["src/**"],
      "rules": {
        "react-hooks/exhaustive-deps": "off"
      }
    }
  ]
}
