{
  "version": 1,
  "ports": {"preview": 3000, "additional": {}},
  "scripts": {
    "setup": {"enabled": true, "command": "bash scripts/hoplite-setup.sh"},
    "run": {"enabled": true, "command": null},
    "archive": {"enabled": true, "command": null},
    "check": {"enabled": true, "command": null}
  },
  "mcpServers": [
    {
      "name": "codegraph",
      "enabled": true,
      "config": {
        "transport": "stdio",
        "command": "codegraph",
        "args": ["serve", "--mcp"],
        "cwd": ".",
        "env": {"CODEGRAPH_TELEMETRY": "0"}
      }
    }
  ]
}
