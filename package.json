{
  "name": "pod",
  "version": "0.0.86",
  "private": true,
  "description": "Pod web dashboard",
  "scripts": {
    "dev": "bun run build:sw && bun --bun next dev --turbopack --port 20128",
    "build": "bun run build:sw && NODE_ENV=production bun --bun next build --turbopack && bun run gen:sw-version",
    "build:sw": "bun run scripts/build-sw.ts",
    "gen:sw-version": "bun run scripts/gen-sw-version.ts",
    "start": "NODE_ENV=production bun ./.next/standalone/server.js",
    "format": "oxfmt --write .",
    "check": "bun scripts/check-open-sse-ts-nocheck.ts && oxfmt --write . && oxlint . --deny-warnings && tsc --noEmit",
    "lint": "oxlint . --deny-warnings",
    "test:run": "vitest run --reporter=verbose",
    "test:live": "vitest run --config vitest.live.config.ts --reporter=verbose",
    "test:coverage": "vitest run --coverage --reporter=verbose"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@xyflow/react": "^12.11.6",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "4.4.0",
    "jose": "^6.2.10",
    "lowdb": "^7.0.1",
    "lucide-react": "^1.24.0",
    "monaco-editor": "^0.55.1",
    "next": "^16.3.4",
    "node-machine-id": "^1.1.12",
    "open": "^11.0.2",
    "ora": "^9.4.1",
    "prop-types": "^15.8.1",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "shadcn": "^4.20.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "undici": "^8.7.0",
    "uuid": "^14.0.2",
    "vaul": "^1.1.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "^4.1.11",
    "better-sqlite3": "^12.11.1",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "bun@1.4.0",
  "trustedDependencies": [
    "better-sqlite3",
    "sharp"
  ]
}
