{
  "name": "pod",
  "version": "0.0.82",
  "private": true,
  "description": "Pod web dashboard",
  "scripts": {
    "dev": "bun --bun next dev --turbopack --port 20128",
    "build": "bun run gen:open-sse-shims && NODE_ENV=production bun --bun next build --turbopack && bun run gen:sw-version",
    "gen:open-sse-shims": "bun run scripts/gen-open-sse-js-shims.mjs",
    "gen:sw-version": "bun run scripts/gen-sw-version.mjs",
    "start": "NODE_ENV=production bun ./.next/standalone/server.js",
    "format": "bun x oxfmt --write .",
    "check": "bun x oxfmt --write . && bun x oxlint . --deny-warnings && bun x tsc --noEmit",
    "lint": "bun x oxlint . --deny-warnings",
    "test:run": "vitest run --reporter=verbose",
    "test:coverage": "vitest run --coverage --reporter=verbose"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@xyflow/react": "^12.11.2",
    "bcryptjs": "^3.0.3",
    "confbox": "^0.2.4",
    "date-fns": "4.4.0",
    "express": "^5.2.1",
    "fs": "^0.0.1-security",
    "http-proxy-middleware": "^4.2.0",
    "jose": "^6.2.3",
    "lowdb": "^7.0.1",
    "lucide-react": "^1.24.0",
    "marked": "^18.0.6",
    "monaco-editor": "^0.55.1",
    "next": "^16.2.10",
    "node-forge": "^1.4.0",
    "node-machine-id": "^1.1.12",
    "open": "^11.0.0",
    "ora": "^9.4.1",
    "prop-types": "^15.8.1",
    "proper-lockfile": "^4.1.2",
    "react": "19.2.7",
    "react-day-picker": "10.0.1",
    "react-dom": "19.2.7",
    "react-is": "^19.2.7",
    "recharts": "^3.9.2",
    "selfsigned": "^5.5.0",
    "socks-proxy-agent": "^10.1.0",
    "sonner": "^2.0.7",
    "sql.js": "^1.14.1",
    "undici": "^8.7.0",
    "uuid": "^14.0.1",
    "vaul": "^1.1.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "better-sqlite3": "^12.11.1",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "postcss": "^8.5.16",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "better-sqlite3",
    "sharp"
  ]
}
